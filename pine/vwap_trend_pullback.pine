//@version=6
strategy("VWAP trend pullback (BTC)", shorttitle="VWAP pullback", overlay=true, pyramiding=1, process_orders_on_close=true, initial_capital=10000, commission_type=strategy.commission.percent, commission_value=0.055, slippage=1, margin_long=100, margin_short=100)

// Trade with the day's trend after a pullback to VWAP, for BTCUSDT (any 24/7 crypto pair).
// VWAP restarts every day at 00:00 UTC, like the daily candle.
// Long: close above VWAP, VWAP above its value 5 bars ago, 20 EMA above 50 EMA, at least one of the
// previous 3 candles touched VWAP (low at or below it), and the signal candle is bullish.
// Short: mirrored. Entry at the signal candle's close.
// Stop: lowest low of the pullback candles (the previous 3 and the signal candle) minus 1 tick;
// shorts mirrored. Target 2R. Skipped when the stop is wider than 1.5 x ATR(14), or when price was
// more than 2 x ATR from VWAP on the candle before the pullback. A VWAP touch can only be used once:
// after an entry, the next trade needs a touch that comes after it.
// Size: by default each trade risks $100: quantity = $100 / stop distance, rounded down to 0.001 BTC
// and never more than 100% of equity (1x). Or a fixed % of equity per trade.
// Optional: trade only between set hours, close open trades at a set time, max trades per day.
// Commission 0.055% per side is Bybit's taker fee for USDT perpetuals; change it under Properties.
//
// Alerts: create one alert on this strategy with the message {{strategy.order.alert_message}}.

stratName = "VWAP pullback"

// --- inputs
gE = "Entries"
useLong = input.bool(true, "Take longs", group=gE)
useShort = input.bool(true, "Take shorts", group=gE)
slopeBars = input.int(5, "VWAP slope: compare with (bars ago)", minval=1, group=gE)
fastLen = input.int(20, "Fast EMA", minval=2, group=gE)
slowLen = input.int(50, "Slow EMA", minval=2, group=gE)
pbBars = input.int(3, "VWAP touch within the previous (candles)", minval=1, maxval=20, group=gE)
maxExtAtr = input.float(2.0, "Skip if price was this far from VWAP before the pullback (× ATR, 0 = off)", minval=0.0, step=0.25, group=gE)

gX = "Stop, target and size"
bufTicks = input.int(1, "Stop buffer (ticks)", minval=0, group=gX)
atrLen = input.int(14, "ATR length", minval=1, group=gX)
maxStopAtr = input.float(1.5, "Skip if the stop is wider than (× ATR, 0 = off)", minval=0.0, step=0.25, group=gX)
rr = input.float(2.0, "Take profit (× initial risk)", minval=0.1, step=0.25, group=gX)
sizeMode = input.string("Fixed $ risk", "Position size", options=["Fixed $ risk", "% of equity"], group=gX)
riskUsd = input.float(100.0, "Risk per trade ($)", minval=1.0, step=10.0, group=gX, tooltip="Quantity = risk ÷ stop distance, rounded down. Fees come on top.")
equityPct = input.float(100.0, "Size, % of equity (the most a trade may use in $ risk mode)", minval=1.0, maxval=1000.0, group=gX, tooltip="100 = 1x. Above 100 uses leverage.")
qtyStep = input.float(0.001, "Quantity step", minval=0.000001, step=0.001, group=gX, tooltip="Smallest order size: 0.001 BTC on Bybit and Binance.")

gS = "Time filters (optional)"
tz = input.string("UTC", "Times are in", options=["UTC", "Europe/Stockholm", "America/New_York"], group=gS)
useWindow = input.bool(false, "Only enter between", inline="w", group=gS)
winSess = input.session("1345-1530", "", inline="w", group=gS, tooltip="1345-1530 UTC is 9:45-11:30 New York in summer. Choose America/New_York above to follow New York's clock all year.")
useFlat = input.bool(false, "Close open trades at (HHMM)", inline="f", group=gS)
flatAt = input.int(2355, "", minval=0, maxval=2359, inline="f", group=gS)
maxTrades = input.int(0, "Max trades per day (0 = no limit)", minval=0, group=gS)

// --- helpers
px(x) => str.tostring(x, format.mintick)
usd(x) => "$" + str.tostring(x, "#,##0.00")
entryText(bool buy, float sl, float tp, float qty) =>
    risk = math.abs(close - sl)
    (buy ? "🟢 LONG " : "🔻 SHORT ") + syminfo.ticker + " (" + stratName + ")\nEntry: " + px(close) + "\nStop: " + px(sl) + "\nTake profit: " + px(tp) + " (" + str.tostring(math.abs(tp - close) / risk, "#.##") + "R)\nSize: " + str.tostring(qty) + " " + syminfo.basecurrency + " (" + usd(qty * close) + ")\nRisk: " + usd(risk * syminfo.pointvalue * qty)

// --- days and time filters
utcDay = dayofmonth(time, "UTC")
newUtcDay = bar_index == 0 or utcDay != utcDay[1]
localDay = dayofmonth(time, tz)
newLocalDay = bar_index == 0 or localDay != localDay[1]
inWin = not useWindow or not na(time(timeframe.period, winSess, tz))
// the time exit fires on the first candle that closes at or after the set time
closeMin = hour(time_close, tz) * 60 + minute(time_close, tz)
flatMin = math.floor(flatAt / 100) * 60 + flatAt % 100
late = useFlat and closeMin >= flatMin and closeMin < flatMin + timeframe.in_seconds() / 60

var int tradesToday = 0
if newLocalDay
    tradesToday := 0

// --- indicators
vw = ta.vwap(hlc3, newUtcDay)
eF = ta.ema(close, fastLen)
eS = ta.ema(close, slowLen)
atr = ta.atr(atrLen)

// a VWAP touch in the previous pbBars candles that came after the last entry
var int lastEntryBar = -1
touchL = false
touchS = false
for i = 1 to pbBars
    if bar_index - i > lastEntryBar
        if low[i] <= vw[i]
            touchL := true
        if high[i] >= vw[i]
            touchS := true

extOk = maxExtAtr == 0 or math.abs(close[pbBars + 1] - vw[pbBars + 1]) <= maxExtAtr * atr[pbBars + 1]
stopL = math.round_to_mintick(ta.lowest(low, pbBars + 1) - bufTicks * syminfo.mintick)
stopS = math.round_to_mintick(ta.highest(high, pbBars + 1) + bufTicks * syminfo.mintick)
riskOkL = maxStopAtr == 0 or close - stopL <= maxStopAtr * atr
riskOkS = maxStopAtr == 0 or stopS - close <= maxStopAtr * atr

// quantity for a stop this far away
sizeFor(float riskPts) =>
    capQty = strategy.equity * equityPct / 100 / close
    raw = sizeMode == "% of equity" ? capQty : math.min(riskUsd / (riskPts * syminfo.pointvalue), capQty)
    math.floor(raw / qtyStep) * qtyStep
qtyL = sizeFor(close - stopL)
qtyS = sizeFor(stopS - close)

isLong = strategy.position_size > 0
isShort = strategy.position_size < 0
isFlat = strategy.position_size == 0
canTrade = isFlat and inWin and (maxTrades == 0 or tradesToday < maxTrades) and not late

longSig = canTrade and useLong and close > vw and vw > vw[slopeBars] and eF > eS and touchL and close > open and extOk and riskOkL and qtyL >= qtyStep
shortSig = canTrade and useShort and close < vw and vw < vw[slopeBars] and eF < eS and touchS and close < open and extOk and riskOkS and qtyS >= qtyStep

// --- orders
var float slPx = na
var float tpPx = na

if longSig
    slPx := stopL
    tpPx := math.round_to_mintick(close + rr * (close - stopL))
    tradesToday += 1
    lastEntryBar := bar_index
    strategy.entry("Long", strategy.long, qty=qtyL, alert_message=entryText(true, slPx, tpPx, qtyL))
else if shortSig
    slPx := stopS
    tpPx := math.round_to_mintick(close - rr * (stopS - close))
    tradesToday += 1
    lastEntryBar := bar_index
    strategy.entry("Short", strategy.short, qty=qtyS, alert_message=entryText(false, slPx, tpPx, qtyS))

// placed on the entry candle too, so the stop and target are live from the next candle
if isLong or longSig
    strategy.exit("LX", from_entry="Long", stop=slPx, limit=tpPx, comment_loss="Stop", comment_profit="TP", alert_loss="🛑 STOP " + syminfo.ticker + " long closed at " + px(slPx) + ". Cancel the take profit order.", alert_profit="🎯 TAKE PROFIT " + syminfo.ticker + " long closed at " + px(tpPx) + ". Cancel the stop order.")
if isShort or shortSig
    strategy.exit("SX", from_entry="Short", stop=slPx, limit=tpPx, comment_loss="Stop", comment_profit="TP", alert_loss="🛑 STOP " + syminfo.ticker + " short closed at " + px(slPx) + ". Cancel the take profit order.", alert_profit="🎯 TAKE PROFIT " + syminfo.ticker + " short closed at " + px(tpPx) + ". Cancel the stop order.")

if late and not isFlat
    strategy.close_all(comment="Time exit", alert_message="⏰ TIME EXIT " + syminfo.ticker + ": close your " + (isLong ? "long" : "short") + " now at " + px(close) + " and cancel the stop and take profit orders.")

// --- plots
plot(vw, "Daily VWAP (00:00 UTC)", color=color.blue, linewidth=2)
plot(eF, "Fast EMA", color=color.teal)
plot(eS, "Slow EMA", color=color.orange)
bgcolor(useWindow and inWin ? color.new(color.blue, 95) : na, title="Entry window")
plot(not isFlat ? slPx : na, "Stop", color=color.red, style=plot.style_linebr)
plot(not isFlat ? tpPx : na, "Take profit", color=color.green, style=plot.style_linebr)
