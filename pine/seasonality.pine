//@version=6
// Padysak & Vojtko (2022) seasonality: long BTC only during a fixed 2h UTC window each day.
// Run on a 1h chart. entryHour=21 is the paper's 21:00-23:00 window; 22 is Quantpedia's 22:00-24:00.
strategy("BTC Seasonality 21-23 UTC", overlay=true, pyramiding=1, process_orders_on_close=true, commission_type=strategy.commission.percent, commission_value=0.05, initial_capital=10000, default_qty_type=strategy.percent_of_equity, default_qty_value=100, margin_long=100, margin_short=100)

entryHour = input.int(21, "Entry hour (UTC)")
holdHours = input.int(2, "Hold hours")

// UTC hour at which this bar closes (orders fill on bar close)
closeHour = (math.floor(time / 3600000) + 1) % 24
exitHour = (entryHour + holdHours) % 24

longEntry = closeHour == entryHour
longExit = closeHour == exitHour

if longEntry and strategy.position_size == 0
    strategy.entry("L", strategy.long)
if longExit and strategy.position_size > 0
    strategy.close("L")

plot(longEntry ? 1 : 0, title="longEntry")
plot(longExit ? 1 : 0, title="longExit")
